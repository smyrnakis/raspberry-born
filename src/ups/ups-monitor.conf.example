# Copy this file to ups-monitor.conf and adapt it locally. The working file is
# ignored by Git. Values are literal text; shell expansion is not supported.
UPS_NAME=myups@localhost
UPS_DRIVER_SERVICE=nut-driver@myups.service
NUT_SERVER_SERVICE=nut-server.service
NUT_MONITOR_SERVICE=nut-monitor.service

# Declare a communication incident after this many consecutive failed polls.
COMM_FAILURE_CHECKS=2

# Send a fresh status report this often while operating on battery.
BATTERY_UPDATE_SECONDS=300

# Runtime estimation is used only when the UPS does not report battery.runtime.
RUNTIME_ESTIMATE_WINDOW_SECONDS=900
RUNTIME_ESTIMATE_MIN_SAMPLES=5
RUNTIME_ESTIMATE_MIN_SPAN_SECONDS=240
RUNTIME_ESTIMATE_MIN_DROP_VOLTS=0.2
RUNTIME_ESTIMATE_MAX_SECONDS=86400

# Communication reminders: 1 h, 4 h, 16 h, 64 h, 256 h and 30 d, then monthly.
COMM_REMINDER_OFFSETS_SECONDS=3600 14400 57600 230400 921600 2592000
COMM_MONTHLY_REMINDER_SECONDS=2592000
