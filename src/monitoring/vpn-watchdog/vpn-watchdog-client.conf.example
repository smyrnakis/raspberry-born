# Client profile. Copy to the ignored vpn-watchdog.conf and adjust locally.
ROLE=client
VPN_SERVICE=openvpn-client@CLIENT_NAME.service
VPN_INTERFACE=tun0
EXPECTED_TUNNEL_CIDR=10.8.0.20/24
VPN_PEER=10.8.0.1

# Any successful request proves that ordinary Internet access still works.
INTERNET_CHECK_URLS=https://cloudflare.com/cdn-cgi/trace https://www.google.com/generate_204
INTERNET_CONNECT_TIMEOUT=3
INTERNET_MAX_TIME=8

# Notify after 10 minutes, then after 1, 6 and 11 hours.
FAILURE_NOTIFY_SECONDS=600
REMINDER_SECONDS=3600 21600 39600

# Restart only a confirmed inactive/failed local OpenVPN service.
RESTART_SECONDS=600 1800 3600
RESTART_SETTLE_SECONDS=25
ALLOW_SERVICE_RESTART=false

# Safe repository default. Raspi3-02 may opt in after recovery tests.
ALLOW_REBOOT=false
REBOOT_AFTER_SECONDS=43200
REBOOT_MIN_INTERVAL_SECONDS=43200
SUPPRESS_REBOOT_WHEN_LOGGED_IN=true
REBOOT_INHIBIT_FILE=/run/raspi-vpn-watchdog/no-reboot
