[Unit]
Description=Deliver queued Raspberry Pi email notifications
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/msmtprc
ConditionPathExists=/etc/raspi-notify/notify.conf

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/raspi-notify-dispatcher
TimeoutStartSec=90
Nice=10
IOSchedulingClass=idle
UMask=0077
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/spool/raspi-notify /run/lock
NoNewPrivileges=true
RestrictSUIDSGID=true
LockPersonality=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
