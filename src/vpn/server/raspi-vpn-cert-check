#!/bin/bash
set -euo pipefail

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
PKI_DIR=/etc/openvpn/server/easy-rsa/pki
STATE_DIR=/var/lib/raspi-vpn-cert-check
NOTIFY=/usr/local/sbin/raspi-notify
REPORT=false

if [[ ${1:-} == --report ]]; then
    REPORT=true
elif [[ $# -ne 0 ]]; then
    echo "Usage: $0 [--report]" >&2
    exit 2
fi

[[ $EUID -eq 0 ]] || { echo "Run this command with sudo." >&2; exit 1; }
[[ -f $PKI_DIR/ca.crt ]] || { echo "Missing $PKI_DIR/ca.crt" >&2; exit 1; }
install -d -o root -g root -m 700 "$STATE_DIR"

notification_bucket() {
    local days=$1 threshold=$2
    if (( days <= 0 )); then echo expired
    elif (( days <= 1 )); then echo 1
    elif (( days <= 7 )); then echo 7
    elif (( days <= 14 )); then echo 14
    elif (( days <= 30 )); then echo 30
    elif (( days <= 60 )); then echo 60
    elif (( days <= 90 )); then echo 90
    elif (( threshold == 180 && days <= 180 )); then echo 180
    else echo healthy
    fi
}

check_certificate() {
    local cert=$1 type=$2 threshold=$3 end_text end_epoch now days bucket
    local fingerprint id state previous subject body

    end_text=$(openssl x509 -in "$cert" -noout -enddate | cut -d= -f2-)
    end_epoch=$(date -d "$end_text" +%s)
    now=$(date +%s)
    days=$(( (end_epoch - now + 86399) / 86400 ))
    bucket=$(notification_bucket "$days" "$threshold")
    fingerprint=$(openssl x509 -in "$cert" -noout -fingerprint -sha256 | cut -d= -f2- | tr -d ':')
    id=$(printf '%s' "$cert" | sha256sum | cut -c1-16)
    state=$STATE_DIR/$id

    if $REPORT; then
        printf '%-6s %5d days  %s  %s\n' "$type" "$days" "$end_text" "$cert"
    fi

    if [[ $bucket == healthy ]]; then
        rm -f -- "$state"
        return
    fi

    previous=""
    [[ ! -f $state ]] || previous=$(<"$state")
    [[ $previous != "$fingerprint $bucket" ]] || return
    if [[ $bucket == expired ]]; then
        subject="[$(hostname --short)] OpenVPN $type certificate expired"
    else
        subject="[$(hostname --short)] OpenVPN $type certificate expires in $days days"
    fi
    body=$(printf 'Certificate: %s\nExpires: %s\nRemaining: %s days\n\nFollow the certificate renewal section in chapters/vpn.md.\n' \
        "$cert" "$end_text" "$days")

    if [[ -x $NOTIFY ]]; then
        printf '%s' "$body" | "$NOTIFY" --key "openvpn-cert-$id" "$subject"
        printf '%s %s\n' "$fingerprint" "$bucket" >"$state"
    else
        logger -p daemon.warning -t raspi-vpn-cert-check "$subject; $cert; expires $end_text"
        printf '%s\n%s' "$subject" "$body"
    fi
}

check_certificate "$PKI_DIR/ca.crt" CA 180
shopt -s nullglob
for cert in "$PKI_DIR"/issued/*.crt; do
    check_certificate "$cert" issued 90
done
